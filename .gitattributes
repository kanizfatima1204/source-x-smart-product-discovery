# Default: normalize line endings to LF on checkout
* text=auto eol=lf

# Shell scripts must always have LF (never CRLF) - critical for Linux/Railway
*.sh text eol=lf

# PHP, JS, CSS, Vue - normalize
*.php text eol=lf
*.js text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.blade.php text eol=lf

# Binary files - no conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.sqlite binary
